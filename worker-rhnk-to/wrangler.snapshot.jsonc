{
	"name": "rhnk-to-snapshot", "account_id": "753ff9292511c16a281c5cfa8e105c63",
	"main": "./static.ts", "compatibility_date": "2026-10-04", "workers_dev": false, "preview_urls": false,
	"assets": { "directory": "../apps/dac7/dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
	"vars": { "BASE_PATH": "/dac7", "ROOT_REDIRECT": "/dac7/" },
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"routes": [{ "pattern": "snapshot.rhnk.to", "custom_domain": true }]
}