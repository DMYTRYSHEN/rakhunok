{
	"$schema": "../worker/node_modules/wrangler/config-schema.json",
	"name": "rhnk-to-landing",
	"account_id": "753ff9292511c16a281c5cfa8e105c63",
	"main": "../worker-rhnk/landing.ts",
	"compatibility_date": "2026-10-04",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".landing-assets",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"routes": [{ "pattern": "rhnk.to/*", "zone_name": "rhnk.to" }]
}