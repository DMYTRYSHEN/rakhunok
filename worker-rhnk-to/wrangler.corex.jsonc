{
	"name": "rhnk-to-corex", "account_id": "753ff9292511c16a281c5cfa8e105c63",
	"main": "./corex.ts", "compatibility_date": "2026-10-04", "workers_dev": false, "preview_urls": false,
	"assets": { "directory": "../build-corex", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
	"services": [{ "binding": "API", "service": "rhnk-to-corex-api" }],
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"routes": [{ "pattern": "rhnk.to/corex", "zone_name": "rhnk.to" }, { "pattern": "rhnk.to/corex/*", "zone_name": "rhnk.to" }]
