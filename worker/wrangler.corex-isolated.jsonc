{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "letsrealtalk-corex",
	"main": "src/corex.ts",
	"compatibility_date": "2026-08-28",
	"workers_dev": false,
	"preview_urls": false,
	"triggers": { "crons": ["* * * * *"] },
	"workflows": [
		{
			"name": "corex-process-production",
			"binding": "COREX_PROCESS_WORKFLOW",
			"class_name": "CorexProcessWorkflow"
		}
	],
	"vars": {
		"SUPABASE_URL": "https://mwaeazabpvbxqfrceogr.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_BOyIBn3I0As0hP_0NutVtg_9ddFdyDk"
	},
	"secrets": { "required": ["SUPABASE_SERVICE_ROLE_KEY"] },
	"assets": {
		"directory": "../build-corex",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "none"
	},
	"routes": [
		{ "pattern": "letsrealtalk.com/corex", "zone_name": "letsrealtalk.com" },
		{ "pattern": "letsrealtalk.com/corex/*", "zone_name": "letsrealtalk.com" }
	],
	"observability": { "enabled": true, "head_sampling_rate": 1 }
}