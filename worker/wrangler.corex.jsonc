{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "letsrealtalk-corex-preview",
	"main": "src/corex.ts",
	"compatibility_date": "2026-08-28",
	"workers_dev": true,
	"preview_urls": true,
	"workflows": [
		{
			"name": "corex-process-preview",
			"binding": "COREX_PROCESS_WORKFLOW",
			"class_name": "CorexProcessWorkflow"
		}
	],
	"vars": {
		"SUPABASE_URL": "https://mwaeazabpvbxqfrceogr.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_BOyIBn3I0As0hP_0NutVtg_9ddFdyDk"
	},
	"secrets": {
		"required": ["SUPABASE_SERVICE_ROLE_KEY"]
	},
	"assets": {
		"directory": "../build",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"env": {
		"production": {
			"name": "letsrealtalk-corex",
			"workers_dev": false,
			"preview_urls": false,
			"workflows": [
				{
					"name": "corex-process-production",
					"binding": "COREX_PROCESS_WORKFLOW",
					"class_name": "CorexProcessWorkflow"
				}
			],
			"vars": {
				"SUPABASE_URL": "https://mwaeazabpvbxqfrceogr.supabase.co",
				"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_BOyIBn3I0As0hP_0NutVtg_9ddFdyDk"
			},
			"secrets": {
				"required": ["SUPABASE_SERVICE_ROLE_KEY"]
			},
			"routes": [
				{
					"pattern": "letsrealtalk.com/corex",
					"zone_name": "letsrealtalk.com"
				},
				{
					"pattern": "letsrealtalk.com/corex/*",
					"zone_name": "letsrealtalk.com"
				}
			]
		}
	}
}