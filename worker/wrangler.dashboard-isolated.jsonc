{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "letsrealtalk-dashboard",
	"main": "src/dashboard.ts",
	"compatibility_date": "2026-08-28",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "../build-dashboard",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "none"
	},
	"services": [{ "binding": "API", "service": "rahunok" }],
	"routes": [{ "pattern": "letsrealtalk.com/dashboard*", "zone_name": "letsrealtalk.com" }],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
