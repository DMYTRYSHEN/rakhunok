{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "letsrealtalk-dashboard-preview",
	"main": "src/dashboard.ts",
	"compatibility_date": "2026-08-28",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "../build",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"env": {
		"production": {
			"name": "letsrealtalk-dashboard",
			"workers_dev": false,
			"preview_urls": false,
			"services": [
				{
					"binding": "API",
					"service": "rahunok"
				}
			],
			"routes": [
				{
					"pattern": "letsrealtalk.com/dashboard*",
					"zone_name": "letsrealtalk.com"
				}
			]
		}
	}
}