{
	"name": "corex",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"apps/merchant-app",
		"apps/checkout"
	],
	"engines": {
		"node": ">=22.13 <23 || >=24"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:worker": "npm --prefix worker run dev",
		"dev:app": "npm --prefix apps/merchant-app run dev",
		"dev:api": "npm --prefix ../core/worker run dev",
		"build:app": "npm --prefix apps/merchant-app run build",
		"build:checkout": "npm --prefix apps/checkout run build",
		"check:app": "npm --prefix apps/merchant-app run check",
		"check:checkout": "npm --prefix apps/checkout run check",
		"test:app": "npm --prefix apps/merchant-app run test",
		"test:checkout": "npm --prefix apps/checkout run test",
		"generate:processes": "node --experimental-strip-types scripts/generate-process-manifest.ts",
		"build": "npm run generate:processes && vite build && npm run build:docs",
		"build:docs": "node scripts/copy-api-docs.mjs",
		"preview": "vite preview",
		"audit:openapi": "node --experimental-strip-types scripts/audit-openapi-coverage.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run audit:openapi && npm run generate:processes && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run lint:format && npm run lint:eslint",
		"lint:format": "prettier --check .",
		"lint:eslint": "eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --passWithNoTests",
		"test:invoice-db": "node scripts/invoice-db-scenarios.mjs",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "playwright test",
		"worker:check:production": "npm --prefix worker run check:production",
		"worker:check:dashboard:production": "npm --prefix worker run check:dashboard:production",
		"worker:check:corex:production": "npm --prefix worker run check:corex:production",
		"worker:deploy:production": "npm --prefix worker run deploy:production",
		"worker:deploy:dashboard:production": "npm --prefix worker run deploy:dashboard:production",
		"worker:deploy:corex:production": "npm --prefix worker run deploy:corex:production",
		"deploy:production": "node scripts/deploy-production.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "4.2.3",
		"@hugeicons/svelte": "1.1.4",
		"@lucide/svelte": "^1.34.0",
		"@supabase/supabase-js": "^2.112.4",
		"@xyflow/svelte": "^1.6.5",
		"mermaid": "^11.17.2",
		"webgl-fluid": "^0.4.0"
	}
}
