{
	"$schema": "../worker/node_modules/wrangler/config-schema.json",
	"name": "rhnk-dashboard",
	"main": "../worker/src/dashboard.ts",
	"compatibility_date": "2026-09-10",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "../build-dashboard",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "none"
	},
	"services": [{ "binding": "API", "service": "rhnk-web" }],
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"routes": [
		{ "pattern": "rhnk.pp.ua/dashboard", "zone_name": "rhnk.pp.ua" },
		{ "pattern": "rhnk.pp.ua/dashboard/*", "zone_name": "rhnk.pp.ua" }
	]
}