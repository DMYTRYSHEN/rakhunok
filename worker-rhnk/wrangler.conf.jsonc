{
	"$schema": "../worker/node_modules/wrangler/config-schema.json",
	"name": "rhnk-conf",
	"main": "../worker/src/conf.ts",
	"compatibility_date": "2026-09-10",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "../apps/conf/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"services": [{ "binding": "API", "service": "rhnk-web" }],
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"routes": [
		{ "pattern": "rhnk.pp.ua/conf", "zone_name": "rhnk.pp.ua" },
		{ "pattern": "rhnk.pp.ua/conf/*", "zone_name": "rhnk.pp.ua" }
	],
	"d1_databases": [
		{
			"binding": "BANK_CATALOG_DB",
			"database_name": "letsrealtalk-conf-snapshots",
			"database_id": "2e5d61b8-d603-420e-8a17-231cd5c9340f"
		}
	],
	"vars": {
		"CONF_SUPABASE_URL": "https://mwaeazabpvbxqfrceogr.supabase.co",
		"CONF_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_BOyIBn3I0As0hP_0NutVtg_9ddFdyDk",
		"CONF_BANK_SYNC_ADMIN_IDS": "*"
	}
}