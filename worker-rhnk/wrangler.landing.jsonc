{
	"$schema": "../worker/node_modules/wrangler/config-schema.json",
	"name": "rhnk-landing",
	"main": "./landing.ts",
	"compatibility_date": "2026-09-10",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./.landing-assets",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"routes": [{ "pattern": "rhnk.pp.ua", "custom_domain": true }]
}