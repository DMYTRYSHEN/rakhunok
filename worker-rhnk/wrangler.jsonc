{
	"$schema": "../worker/node_modules/wrangler/config-schema.json",
	"name": "rhnk-web",
	"main": "../worker/src/index.ts",
	"compatibility_date": "2026-09-10",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "../build",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"vars": {
		"PUBLIC_DOMAIN": "https://rhnk.pp.ua",
		"MERCHANT_API_KEYS_ENABLED": "false",
		"TELEGRAM_INVOICE_PUBLIC_ORIGIN": "https://rhnk.pp.ua",
		"SUPABASE_URL": "https://mwaeazabpvbxqfrceogr.supabase.co",
		"SUPABASE_ANON_KEY": "sb_publishable_BOyIBn3I0As0hP_0NutVtg_9ddFdyDk"
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"d1_databases": [
		{
			"binding": "BANK_CATALOG_DB",
			"database_name": "letsrealtalk-conf-snapshots",
			"database_id": "2e5d61b8-d603-420e-8a17-231cd5c9340f"
		}
	],
	"r2_buckets": [
		{
			"binding": "BANK_LOGOS_BUCKET",
			"bucket_name": "rhnk-bank-logos"
		}
	]
}