{
	"$schema": "../worker/node_modules/wrangler/config-schema.json",
	"name": "rhnk-demo-web",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-10",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "../build",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	},
	"routes": [{ "pattern": "rhnk.pp.ua", "custom_domain": true }]
}