{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "rakhunok-dashboard",
	"main": "../worker/src/dashboard.ts",
	"compatibility_date": "2026-08-28",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "../build",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"services": [
		{
			"binding": "API",
			"service": "rahunok"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"routes": [
		{
			"pattern": "rakhunok.com/dashboard*",
			"zone_name": "rakhunok.com"
		}
	]
}
